<?import com.comp2042.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<Pane fx:controller="com.comp2042.GuiController"
      xmlns:fx="http://javafx.com/fxml">

    <GridPane fx:id="brickPanel" vgap="1" hgap="1"/>

    <BorderPane styleClass="gameBoard" fx:id="gameBoard">
        <center>
            <!-- 用 StackPane 层叠 gamePanel 和 PAUSED -->
            <StackPane>

                <GridPane fx:id="gamePanel" vgap="1" hgap="1"/>
                <!-- PAUSED 字样，会自动在蓝色框中间 -->
                <Text fx:id="pauseText"
                      text="PAUSED"
                      visible="false"
                      style="-fx-font-size: 48px; -fx-fill: white; -fx-font-weight: bold;"
                      opacity="0.85"/>

            </StackPane>

        </center>
    </BorderPane>

    <Group fx:id="groupNotification" layoutX="14" layoutY="203">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>



    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
    <Label fx:id="scoreLabel"
           text="Score: 0"
           layoutX="250"
           layoutY="50"
           style="-fx-font-size:24px; -fx-text-fill:white;"/>
    <Label fx:id="comboLabel"

           layoutX="250"
           layoutY="90"
           style="-fx-font-size: 22px; -fx-text-fill: yellow; -fx-font-weight:bold;"/>
    <VBox layoutX="250" layoutY="140" spacing="10">

        <Label text="Next"
               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />

        <StackPane fx:id="nextContainer"
                   style="-fx-background-color: rgba(255,255,255,0.05);
                      -fx-border-color: #FFFFFF88;
                      -fx-border-width: 2;
                      -fx-border-radius: 8;
                      -fx-background-radius: 8;"
                   prefWidth="120" prefHeight="120">

            <!-- nextPanel 放在 StackPane 中居中显示 -->
            <GridPane fx:id="nextPanel"
                      hgap="2" vgap="2"
                      alignment="CENTER"/>
        </StackPane>

    </VBox>





</Pane>
