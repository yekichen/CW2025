<?import com.comp2042.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<Pane fx:controller="com.comp2042.GuiController"
      xmlns:fx="http://javafx.com/fxml">

    <GridPane fx:id="brickPanel" vgap="1" hgap="1"/>

    <BorderPane styleClass="gameBoard" fx:id="gameBoard">
        <center>
            <!-- 用 StackPane 层叠 gamePanel 和 PAUSED -->
            <StackPane>

                <GridPane fx:id="gamePanel" vgap="1" hgap="1"/>
                <!-- PAUSED 字样，会自动在蓝色框中间 -->
                <Text fx:id="pauseText"
                      text="PAUSED"
                      visible="false"
                      style="-fx-font-size: 48px; -fx-fill: white; -fx-font-weight: bold;"
                      opacity="0.85"/>
                <Text fx:id="pressStartText"
                      text="PRESS START TO BEGIN"
                      style="-fx-font-size: 40px; -fx-fill: white; -fx-font-weight: bold;"
                      opacity="0.85"/>

            </StackPane>

        </center>
    </BorderPane>

    <Group fx:id="groupNotification" layoutX="14" layoutY="203">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>



    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>

    <!-- ========================= -->
    <!--        RIGHT  PANEL       -->
    <!-- ========================= -->

    <StackPane fx:id="rightPanel"
               layoutX="520"
               layoutY="40"
               prefWidth="260"
               prefHeight="600"
               style="
               -fx-background-color: rgba(20, 20, 20, 0.55);
               -fx-background-radius: 18;
               -fx-border-radius: 18;
               -fx-border-color: #5ac6ff;
               -fx-border-width: 3;
               -fx-effect: dropshadow(gaussian, rgba(0,255,255,0.45), 25, 0.6, 0, 0);
           ">

        <VBox spacing="16" alignment="TOP_CENTER">

            <!-- Score / Level / Cleared / Combo -->
            <Label fx:id="scoreLabel"
                   style="-fx-font-size: 24px; -fx-text-fill:white;"/>
            <Label fx:id="levelLabel"
                   style="-fx-font-size: 20px; -fx-text-fill:white;"/>
            <Label fx:id="linesLabel"
                   style="-fx-font-size: 20px; -fx-text-fill: cyan; -fx-font-weight:bold;"/>
            <Label fx:id="comboLabel"
                   style="-fx-font-size: 22px; -fx-text-fill: yellow; -fx-font-weight:bold;"/>

            <!-- NEXT title -->
            <Label text="Next"
                   style="-fx-text-fill: white; -fx-font-size: 26px;"/>

            <!-- Next Block Preview -->
            <StackPane>
                <Rectangle width="140" height="140"
                           arcWidth="20" arcHeight="20"
                           fill="transparent"
                           stroke="white" strokeWidth="2"/>

                <GridPane fx:id="nextPanel"
                          hgap="2" vgap="2"
                          prefWidth="120" prefHeight="120"
                          alignment="CENTER"/>
            </StackPane>

            <!-- HOLD title -->
            <Label text="Hold"
                   style="-fx-text-fill: white; -fx-font-size: 22px;"/>

            <!-- Hold Block Preview -->
            <StackPane>
                <Rectangle width="140" height="140"
                           arcWidth="20" arcHeight="20"
                           fill="transparent"
                           stroke="white" strokeWidth="2"/>

                <GridPane fx:id="holdPanel"
                          hgap="2" vgap="2"
                          prefWidth="120" prefHeight="120"
                          alignment="CENTER"/>
            </StackPane>

            <!-- Control Buttons -->
            <Label text="Controls"
                   style="-fx-text-fill: white; -fx-font-size: 22px;"/>

            <Button fx:id="btnStart"
                    text="Start"
                    prefWidth="140"
                    style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #4CAF50; -fx-text-fill:white;"/>

            <Button fx:id="btnPause"
                    text="Pause"
                    prefWidth="140"
                    style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #2196F3; -fx-text-fill:white;"/>

            <Button fx:id="btnRestart"
                    text="Restart"
                    prefWidth="140"
                    style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #FFC107; -fx-text-fill:black;"/>

            <Button fx:id="btnQuit"
                    text="Quit"
                    prefWidth="140"
                    style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #F44336; -fx-text-fill:white;"/>

        </VBox>

    </StackPane>




</Pane>
